# ============================================================================
# StayIn — Backend (DLU X ALFATEVE)
# Copy to .env and adjust. Never commit the real .env.
#
# Two applications, two separate PostgreSQL databases:
#   stayin_main  = server utama: CMS, katalog master, distribusi, akun admin
#   stayin_local = server lokal kapal: TV, streaming, mst_movie_local, layout
# ============================================================================

# combined = both applications in one process, two separate databases (dev)
# main     = CMS/authoring only, opens MAIN_DATABASE_URL
# local    = TV/streaming only, opens LOCAL_DATABASE_URL
APP_MODE=combined

HTTP_ADDR=:8080
LOG_LEVEL=info
TZ=Asia/Jakarta

# ---------------------------------------------------------------------------
# Databases (two distinct database objects; never the same name)
# ---------------------------------------------------------------------------
MAIN_DATABASE_URL=postgres://stayin:stayin@localhost:5432/stayin_main?sslmode=disable
LOCAL_DATABASE_URL=postgres://stayin:stayin@localhost:5432/stayin_local?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# Shared secret the local node uses to POST /api/v1/nodes/inventory.
# Leave empty to disable the endpoint.
NODE_API_KEY=change-me-node-key

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-32-byte-random-string-please
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=168h
COOKIE_SECURE=false
COOKIE_DOMAIN=

# CORS: comma separated. Use the LAN origin of the CMS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Bootstrap accounts (created only when mst_users is empty)
# ---------------------------------------------------------------------------
BOOTSTRAP_SUPER_ADMIN_EMAIL=owner@stayin.local
BOOTSTRAP_SUPER_ADMIN_PASSWORD=Owner#2026
BOOTSTRAP_SUPER_ADMIN_NAME=StayIn Owner
BOOTSTRAP_TENANT_ADMIN_EMAIL=admin@dlu-alfateve.local
BOOTSTRAP_TENANT_ADMIN_PASSWORD=Mitra#2026
BOOTSTRAP_TENANT_ADMIN_NAME=DLU Alfateve Admin

# ---------------------------------------------------------------------------
# Tenant
# ---------------------------------------------------------------------------
TENANT_SLUG=dlu-alfateve
TENANT_NAME=DLU X ALFATEVE

# ---------------------------------------------------------------------------
# Media storage (inside container: /DATA/Media)
# ---------------------------------------------------------------------------
MEDIA_ROOT=/DATA/Media
MEDIA_MOVIES_DIR=Movies
MEDIA_BANNERS_DIR=Banners
MEDIA_POSTERS_DIR=Posters
MEDIA_APK_DIR=Apk

# ---------------------------------------------------------------------------
# Media ingest engine (flashdisk directory mapping -> PostgreSQL)
# ---------------------------------------------------------------------------
SCAN_ON_START=true
SCAN_INTERVAL_SECONDS=300
SCAN_COMPUTE_HASH=true
SCAN_HASH_WORKERS=2
SCAN_MAX_DEPTH=6

# ---------------------------------------------------------------------------
# Streaming
# ---------------------------------------------------------------------------
STREAM_BUFFER_BYTES=65536
STREAM_MAX_OPEN_FILES=256
STREAM_CACHE_SECONDS=86400

# ---------------------------------------------------------------------------
# WebSocket
# ---------------------------------------------------------------------------
WS_PING_INTERVAL_SECONDS=25
WS_WRITE_TIMEOUT_SECONDS=10
HEARTBEAT_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Upload / pairing
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=20971520
PAIRING_TTL_MINUTES=30

# ---------------------------------------------------------------------------
# Sync worker (leave CLOUD_BASE_URL empty for fully local operation)
# ---------------------------------------------------------------------------
SYNC_INTERVAL_SECONDS=15
CLOUD_BASE_URL=
CLOUD_API_KEY=

# Reverse proxy / tunnel
TRUSTED_PROXIES=
